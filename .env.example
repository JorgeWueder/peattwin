# Copia este archivo a .env (en la raiz del repo) y ajusta los valores a tu
# instalacion local de PostgreSQL
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env

PROJECT_NAME=PeatTwin
ENVIRONMENT=development

# --- PostgreSQL local (servicio nativo, NO contenedor) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=peattwin

# --- ML / prediccion ---
# Ruta explicita al modelo (opcional). Si se deja vacia se usa ml_models.file_path
# de la BD y, si no, <repo>/ml/models/modelo_final.{pkl,h5}
MODEL_FILE=
